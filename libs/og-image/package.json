{
  "name": "@mastrojs/og-image",
  "version": "0.1.0",
  "description": "Generate PNG images from text for link previews.",
  "scripts": {
    "check": "tsc --noEmit",
    "prepack": "node ../../prepack.ts",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "homepage": "https://github.com/mastrojs/mastro/tree/main/libs/og-image",
  "bugs": "https://github.com/mastrojs/mastro/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastrojs/mastro.git",
    "directory": "libs/og-image"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!**/*.test.*",
    "!**/*.bench.*"
  ],
  "type": "module",
  "exports": {
    ".": "./src/ogImage.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/ogImage.d.ts",
        "default": "./dist/ogImage.js"
      }
    },
    "directory": "dist",
    "linkDirectory": false
  },
  "dependencies": {
    "canvaskit-wasm": "^0.42.0"
  }
}
