{
  "name": "@mastrojs/api",
  "version": "0.1.1",
  "description": "Build type-safe JSON REST APIs and clients with Mastro.",
  "scripts": {
    "check": "tsc --noEmit",
    "prepack": "node ../../prepack.ts",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "homepage": "https://github.com/mastrojs/mastro/tree/main/libs/api",
  "bugs": "https://github.com/mastrojs/mastro/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastrojs/mastro.git",
    "directory": "libs/api"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!**/*.test.*",
    "!**/*.bench.*"
  ],
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "directory": "dist",
    "linkDirectory": false
  },
  "dependencies": {
    "@mastrojs/mastro": "^0",
    "@mastrojs/result": "^0"
  }
}
