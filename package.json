{
  "name": "mastro-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm -r --filter '!./examples/**' run check",
    "fmt": "oxfmt -c .oxfmtrc.json",
    "test": "pnpm -r run test",
    "bench": "pnpm -r run bench"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxfmt": "^0.75.0",
    "typescript": "^7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  }
}
